<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <!--[if mso]>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
          <o:AllowPNG />
        </o:OfficeDocumentSettings>
      </xml>
    <![endif]-->

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        background-color: #f3f4f6;
      }

      .container {
        max-width: 600px;
        margin: 20px auto;
        background-color: #ffffff;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        overflow: hidden;
      }

      .header {
        background: linear-gradient(135deg, #1f1817 0%, #d8532c 100%);
        padding: 16px;
        text-align: center;
      }

      .logo {
        width: 64px;
        height: 64px;
      }

      .logo-text {
        color: #ffffff;
        font-size: 28px;
        font-weight: bold;
      }

      .content {
        padding: 32px 24px;
      }

      .title {
        color: #d8532c;
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 16px;
      }

      .greeting {
        color: #252a70;
        font-size: 18px;
        text-align: center;
        margin-bottom: 24px;
      }

      .otp-container {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border: 2px solid #d8532c;
        border-radius: 12px;
        padding: 24px;
        margin: 24px 0;
        text-align: center;
      }

      .otp-box {
        display: inline-block;
        padding: 16px 32px;
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }

      .otp-label {
        font-size: 14px;
        color: #666;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .otp-code {
        font-size: 32px;
        color: #d8532c;
        font-weight: bold;
        letter-spacing: 4px;
        font-family: 'Courier New', monospace;
      }

      .message {
        text-align: center;
        color: #666;
        font-size: 15px;
        margin: 24px 0;
        line-height: 1.8;
      }

      .warning {
        background-color: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 12px;
        margin: 24px 0;
        font-size: 14px;
        color: #856404;
        border-radius: 4px;
      }

      .expiry {
        color: #dc3545;
        font-weight: bold;
      }

      .footer {
        border-top: 1px solid #e5e7eb;
        padding: 24px;
        text-align: center;
        color: #666;
        font-size: 14px;
        background-color: #f8f9fa;
      }

      .support-link {
        color: #d8532c;
        text-decoration: none;
        font-weight: bold;
      }

      .support-link:hover {
        text-decoration: underline;
      }

      .security-note {
        font-size: 13px;
        color: #6c757d;
        margin-top: 16px;
        font-style: italic;
      }

      @media only screen and (max-width: 600px) {
        .container {
          margin: 0;
          border-radius: 0;
        }

        .content {
          padding: 24px 16px;
        }

        .otp-code {
          font-size: 28px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <img
          src="https://res.cloudinary.com/duka0vipp/image/upload/v1756726523/file-upload/droporf_white_1_eca0jf.png"
          alt="Droporf Logo"
          class="logo"
        />
      </div>
      <div class="content">
        <h1 class="title">Verify Your Account</h1>
        <p class="greeting">Hello <%= name %>,</p>

        <p class="message">
          Thank you for creating an account with Bizvantage. To ensure the security
          of your account, please use the following verification code to
          complete your registration:
        </p>

        <div class="otp-container">
          <div class="otp-box">
            <div class="otp-label">Your Verification Code</div>
            <div class="otp-code"><%= otp %></div>
          </div>
        </div>

        <div class="warning">
          This code will expire in <span class="expiry"><%= duration %> minutes</span>.
          Please do not share this code with anyone.
        </div>

        <p class="message">
          If you didn't request this verification code, please ignore this email
          or contact our support team immediately if you believe this is
          suspicious activity.
        </p>

        <p class="security-note">
          For security reasons, we recommend completing the verification process
          as soon as possible.
        </p>
      </div>

      <div class="footer">
        <p>
          Need help? Contact our support team at
          <a href="mailto:support@bizvantage.com" class="support-link"
            >support@bizvantage.com</a
          >
        </p>
        <p style="margin-top: 12px">©2025 Bizvantage. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
