# ============================================

# Message Queue Configuration
QUEUE_TYPE=memory
# Options: memory, rabbitmq
# Use 'memory' for development (no RabbitMQ needed)
# Use 'rabbitmq' for production
# RabbitMQ Configuration (only needed if QUEUE_TYPE=rabbitmq)
RABBITMQ_ENABLED=false
# Set to true to enable RabbitMQ
# BizVantage Backend - Environment Variables
# Copy this file to .env and fill in your values
# cp .env.sample .env
# Application Configuration
ENV=local
# Options: local, test, staging, production
PORT=3000
# Application server port
APP_NAME=BizVantage API
# Application name (used in Swagger docs)
APP_VERSION=1.0.0
# Application version (used in Swagger docs)
API_PREFIX=api
# API route prefix
SWAGGER_PATH=docs
# Swagger UI path (default: docs)
# Access at: http://localhost:PORT/SWAGGER_PATH
LOG_FIELDS_TO_HIDE=
# Comma-separated list of fields to hide in logs
# Example: password,token,secret
# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=bizvantage_db
DB_CONNECTION_LIMIT=10
DB_RETRY_ATTEMPTS=5
# Number of retry attempts for database connection (default: 5)

DB_RETRY_DELAY=3000

DB_SYNCHRONIZE=false
# Auto-create tables from entities (ONLY for development)
# WARNING: Set to true ONLY in development. This will drop and recreate tables.
# For production, use migrations instead.
# Delay between retry attempts in milliseconds (default: 3000ms = 3 seconds)
# Maximum number of database connections
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Change this to a strong random string in production
JWT_EXPIRES_IN=24h
# JWT token expiration time
# Examples: 1h, 24h, 7d, 30d
# Cache Configuration
CACHE_TYPE=memory
# Options: memory, redis
# Use 'memory' for development (no Redis needed)
# Use 'redis' for production
# Redis Configuration (only needed if CACHE_TYPE=redis)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
# RabbitMQ Configuration
AMQP_URL=amqp://guest:guest@localhost:5672
# RabbitMQ connection URL
# Format: amqp://username:password@host:port
# Email Configuration
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SERVICE=gmail
# Options: gmail, outlook, etc.
# Email Sender Information
SENDER_EMAIL_NAME=BizVantage
SENDER_EMAIL_ADDRESS=noreply@bizvantage.com
# Resend API (Alternative email service)
RESEND_API_KEY=your_resend_api_key
# Optional: If using Resend instead of SMTP
# AWS Configuration
AWS_REGION=us-east-1
AWS_SERVICE_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
# Used for S3, SES, or other AWS services
# Dojah KYC Configuration
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_API_KEY=your_dojah_api_key
DOJAH_APP_ID=your_dojah_app_id
# Used for KYC verification services
# Monnify Payment Configuration
MONNIFY_API_KEY=your_monnify_api_key
MONNIFY_SECRET_KEY=your_monnify_secret_key
MONNIFY_BASE_URL=https://api.monnify.com
# Payment gateway configuration
# Development Notes
# - For local development, you can use:
#   - CACHE_TYPE=memory (no Redis needed)
#   - Minimal database setup
#   - Mock or skip external services (Dojah, Monnify) if not testing those features
#
# - For production, ensure:
#   - Strong JWT_SECRET
#   - Proper database credentials
#   - Redis enabled for cache
#   - All external service credentials are valid
#   - ENV=production
